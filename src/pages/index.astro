---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/swadhin.jpg';
import certifications from '../data/certifications.json';

const badgeImages = import.meta.glob<{ default: ImageMetadata }>('../assets/badges/*.png', { eager: true });
const today = new Date().toISOString().slice(0, 10);
const all = certifications
  .map((c) => ({ ...c, image: badgeImages[`../assets/badges/${c.id}.png`]?.default }))
  .filter((c) => c.image);
const certs = all.filter((c) => !c.expires || c.expires >= today);
const past = all.filter((c) => c.expires && c.expires < today);
const fmt = (d: string) => new Date(d).toLocaleDateString('en', { month: 'short', year: 'numeric' });

const expertise = [
  { title: 'SAP S/4HANA', text: 'Guiding customers through their journey to S/4HANA, from architecture to cutover.' },
  { title: 'Cloud migration', text: 'Moving SAP landscapes and workloads to the cloud with pragmatic, low-risk approaches.' },
  { title: 'SAP BTP', text: 'Cloud-native apps with the SAP Cloud Application Programming Model (CAP) and SAP Fiori Elements.' },
  { title: 'Kubernetes & Kyma', text: 'Deploying on Cloud Foundry and Kyma runtime, with a Kubernetes background (previously CKAD certified).' },
];
const stack = ['SAP S/4HANA', 'SAP BTP', 'SAP CAP', 'Fiori Elements', 'Cloud Foundry', 'Kyma', 'Kubernetes'];
---
<Base>
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow"><span class="dot"></span> Technical Architect · SAP · Cloud</p>
      <h1>Hi, I’m <span class="grad">Swadhin</span>.<br />I build for the SAP cloud.</h1>
      <p class="lead">I help customers get to SAP S/4HANA and the cloud, and build cloud-native apps on SAP BTP with CAP, Fiori Elements, Cloud Foundry and Kyma.</p>
      <div class="cta">
        <a class="btn primary" href="#expertise">What I do</a>
        <a class="btn" href="https://flowcv.com/resume/4r0nje4jj7" target="_blank" rel="noopener">Résumé ↗</a>
        <a class="btn" href="https://www.linkedin.com/in/swadhinpatel" target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
      <ul class="chips" aria-label="Technologies">{stack.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div class="portrait">
      <Image src={photo} alt="Portrait of Swadhin Patel" width={360} height={360} loading="eager" format="webp" quality={82} />
    </div>
  </section>

  <section id="about" class="container section">
    <h2 class="section-title">About</h2>
    <p class="about">
      I’m a Technical Architect with extensive experience in SAP technology and a deep interest in cloud. I hold multiple SAP certifications on SAP cloud technology, and I was previously certified as a Kubernetes Application Developer (CKAD). My recent work is creating cloud-native applications for SAP Business Technology Platform using the SAP Cloud Application Programming Model and SAP Fiori Elements, on Cloud Foundry and Kyma runtime.
    </p>
  </section>

  <section id="expertise" class="container section">
    <h2 class="section-title">Expertise</h2>
    <div class="grid">
      {expertise.map((e) => (
        <article class="card"><h3>{e.title}</h3><p>{e.text}</p></article>
      ))}
    </div>
  </section>

  <section id="certifications" class="container section">
    <h2 class="section-title">Certifications</h2>
    <ul class="certs">
      {certs.map((c) => (
        <li>
          <a class="cert" href={c.url} target="_blank" rel="noopener">
            <Image src={c.image} alt="" width={72} height={72} loading="lazy" />
            <div>
              <h3>{c.name}</h3>
              <p>{c.issuer} · {fmt(c.issued)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    {past.length > 0 && (
      <>
        <h3 class="subhead">Previously certified</h3>
        <ul class="certs past">
          {past.map((c) => (
            <li>
              <a class="cert" href={c.url} target="_blank" rel="noopener">
                <Image src={c.image} alt="" width={72} height={72} loading="lazy" />
                <div>
                  <h3>{c.name}</h3>
                  <p>{c.issuer} · {fmt(c.issued)} – {fmt(c.expires!)}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="muted more"><a href="https://www.credly.com/users/swadhin" target="_blank" rel="noopener">All badges on Credly ↗</a></p>
  </section>

  <section class="container section">
    <div class="banner">
      <div><h2>Words &amp; moments worth keeping</h2><p>A collection of quotes and talks that stuck with me.</p></div>
      <div class="cta"><a class="btn primary" href="/quotes/">Quotes</a><a class="btn" href="/collections/">Collections</a></div>
    </div>
  </section>
</Base>
